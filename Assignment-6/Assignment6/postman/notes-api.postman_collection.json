{
  "info": {
    "name": "Notes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Create note (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Exam topics\",\"body\":\"REST, CRUD\"}"
        }
      }
    },
    {
      "name": "Create note - no title (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"body\":\"oops\"}"
        }
      }
    },
    {
      "name": "Read all (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        }
      }
    },
    {
      "name": "Read all - search/limit (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes?search=exam&sort=newest&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes"
          ],
          "query": [
            {
              "key": "search",
              "value": "exam"
            },
            {
              "key": "sort",
              "value": "newest"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Read one (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "1"
          ]
        }
      }
    },
    {
      "name": "Read one - missing (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "9999"
          ]
        }
      }
    },
    {
      "name": "Replace PUT (200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notes/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"New title\",\"body\":\"New body\"}"
        }
      }
    },
    {
      "name": "Replace PUT - no title (400)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notes/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"body\":\"x\"}"
        }
      }
    },
    {
      "name": "Update PATCH (200)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notes/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Only the title changes\"}"
        }
      }
    },
    {
      "name": "Update PATCH - missing (404)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notes/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "9999"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"x\"}"
        }
      }
    },
    {
      "name": "Delete (204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "1"
          ]
        }
      }
    },
    {
      "name": "Delete again (404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "1"
          ]
        }
      }
    }
  ]
}